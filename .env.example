# Local values only. Copy to .env.local; never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://127.0.0.1:3000
# Only sk_test_ keys are accepted. Blank disables unconfigured billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure Stripe test price IDs in the database plan table, not in this file.

